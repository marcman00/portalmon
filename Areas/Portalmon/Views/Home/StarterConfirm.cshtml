<div class="pk-starter-confirm" data-bind="visible: isShowingStarterConfirm, with: chosenStarter">

	<div class="pk-welcome-inner">

		<!-- GlaDOS portrait -->
		<div class="d-flex align-items-center gap-3 mb-3">
			<div class="pk-glados-portrait" aria-hidden="true">🤖</div>
			<div>
				<div class="pk-glados-name">GLaDOS</div>
				<div class="pk-glados-title">Genetic Lifeform and Disk Operating System</div>
			</div>
		</div>

		<div class="pk-glados-speech" data-bind="typewriter: true">

			<!-- React to their specific choice -->
			<p>
				<span data-bind="text: name"></span>.
				<br>
				An&hellip; <em>adequate</em> choice.
				I&rsquo;m sure it seemed meaningful at the time.
			</p>

			<p>
				<span data-bind="text: name"></span> has been assigned to your care,
				<strong data-bind="text: $parent.trainerName"></strong>.
				Please try to keep it functional.
				Losing your assigned Portalmon in the <em>first</em> encounter
				would set a new record.
				The bad kind.
			</p>

			<p>
				A portal has been activated somewhere on the testing floor.
				Click it to initiate your first encounter.
				If you forget the rules at any point &mdash; and you will &mdash;
				press the <strong>?</strong> button for a full briefing.
			</p>

			<p class="pk-welcome-footer">
				Good luck, <strong data-bind="text: $parent.trainerName"></strong>.
				<br>
				<span class="text-muted" style="font-size: 0.8em;">
					That was a test. Luck is not a variable I control.
					&hellip;Probably.
				</span>
			</p>

		</div>

		<div class="d-flex justify-content-between align-items-center">
			<div class="text-center my-3">
				<div class="pk-confirm-portrait mx-auto">
					<!-- ko if: $data.portraitImage -->
					<img class="pk-portrait-img" data-bind="attr: { src: portraitImage, alt: name }">
					<!-- /ko -->
				</div>
				<div class="small mt-2 fw-bold" data-bind="text: name">Normling</div>
			</div>

			<div class="text-end">
				<button type="button" class="btn pk-btn-begin" data-bind="click: $parent.confirmAndEnterGame">
					Enter Testing Chamber ›
				</button>
			</div>
		</div>


	</div>

</div>
