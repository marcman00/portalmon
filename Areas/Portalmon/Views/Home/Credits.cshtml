<div class="pk-credits-screen">
	<div class="pk-credits-scanlines"></div>

	<div class="pk-credits-scroll">

		<div class="pk-credits-spacer"></div>

		<div class="pk-credits-block">
			<div class="pk-credits-title">PORTALMON</div>
			<div class="pk-credits-subtitle">Gotta Cache 'Em All</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Gym Leaders</div>
			<div class="pk-credits-entry">Coach - Availability Leader</div>
			<div class="pk-credits-entry">Lordis - Security Leader</div>
			<div class="pk-credits-entry">Gargis - Performance Leader</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Champion</div>
			<div class="pk-credits-entry">Rey - The Developer</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Final Boss</div>
			<div class="pk-credits-entry">GLaDOS - Genetic Lifeform and Disk Operating System</div>
			<div class="pk-credits-flavor">"I opened a portal to another universe. And you beat them. With IT infrastructure monsters."</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Cross-Dimensional Imports</div>
			<div class="pk-credits-entry">Venusaur, Blastoise, Charizard</div>
			<div class="pk-credits-flavor">Imported from POKEMON_GEN_1.DB</div>
			<div class="pk-credits-flavor">Override Code: GLADOS-001</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Creature Design</div>
			<div class="pk-credits-entry">Doug, Jake, and Marcus</div>
		</div>
		<div class="pk-credits-block">
			<div class="pk-credits-heading">Editor</div>
			<div class="pk-credits-entry">Jake</div>
		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Celebrating</div>
			<div class="pk-credits-entry">30 Years of Pokemon</div>
			<div class="pk-credits-entry">13 Years of Portal</div>

		</div>

		<div class="pk-credits-block">
			<div class="pk-credits-heading">Special Thanks</div>
			<div class="pk-credits-entry">Marcus - for the vision</div>
			<div class="pk-credits-entry">Jake -  for the incredible polish</div>
			<div class="pk-credits-entry">Jake -  for the batteries</div>
		</div>

		<div class="pk-credits-block pk-credits-glados-quote">
			<div class="pk-credits-flavor">"This was a triumph."</div>
			<div class="pk-credits-flavor">"Where is the cake?"</div>
		</div>

		<div class="pk-credits-spacer"></div>

		<!-- The big reveal -->
		<div class="pk-credits-reveal">
			<div class="pk-credits-april-fools">APRIL FOOLS</div>
			<div class="pk-credits-year">2026</div>
			<div class="pk-credits-year">From the Portal team</div>
		</div>

		<div class="pk-credits-spacer"></div>

	</div>

	<button type="button" class="pk-credits-skip"
			data-bind="click: rebootGame">
		Press START to reboot
	</button>

</div>
